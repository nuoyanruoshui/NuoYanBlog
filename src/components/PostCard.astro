---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	pinned,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await entry.render();
const excerpt = description || remarkPluginFrontmatter.excerpt;
---
<article class:list={["post-card card-base onload-animation", { "post-card--nocover": !hasCover }, className]} style={style}>
    <div class="post-card__main">
        <a href={url} class="post-card__title">
            {pinned && (
                <Icon name="mdi:pin" class="post-card__pin"></Icon>
            )}
            <span class="post-card__title-text">{title}</span>
            <Icon name="material-symbols:arrow-right-alt-rounded" class="post-card__title-arrow"></Icon>
        </a>

        <PostMetadata
            published={published}
            updated={updated}
            tags={tags}
            category={category}
            hideTagsForMobile={true}
            hideUpdateDate={true}
            size="card"
            class="post-card__meta"
        ></PostMetadata>

        {excerpt && <p class="post-card__desc">{excerpt}</p>}

        <div class="post-card__footer">
            <span class="post-card__stat">
                <Icon name="material-symbols:notes-rounded"></Icon>
                {remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}
            </span>
            <span class="post-card__dot"></span>
            <span class="post-card__stat">
                <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                {remarkPluginFrontmatter.minutes} {i18n(I18nKey.minutesCount)}
            </span>
            <a href={url} class="post-card__more">
                {i18n(I18nKey.readMore)}
                <Icon name="material-symbols:chevron-right-rounded"></Icon>
            </a>
        </div>
    </div>

    {hasCover ? (
        <a href={url} aria-label={title} class="post-card__media">
            <span class="post-card__media-inner">
                <span class="post-card__media-scrim"></span>
                <span class="post-card__media-hint">
                    <Icon name="material-symbols:arrow-outward-rounded"></Icon>
                </span>
                <ImageWrapper
                    src={image}
                    basePath={path.join("content/posts/", getDir(entry.id))}
                    alt={`Cover Image of ${title}`}
                    class="h-full w-full"
                    imgClass="post-card__image"
                />
            </span>
        </a>
    ) : (
        <a href={url} aria-label={title} class="post-card__fallback-arrow">
            <Icon name="material-symbols:arrow-right-alt-rounded"></Icon>
        </a>
    )}
</article>

<style>
    .post-card {
        position: relative;
        display: flex;
        flex-direction: column-reverse;
        width: 100%;
        transition: box-shadow 0.4s var(--ease-soft), transform 0.4s var(--ease-soft);
    }

    .post-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-card-hover);
    }

    .post-card__main {
        min-width: 0;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        padding: 1.15rem 1.25rem 1rem;
    }

    @media (min-width: 768px) {
        .post-card {
            flex-direction: row;
            align-items: stretch;
        }

        .post-card__main {
            padding: 1.6rem 1.5rem 1.35rem 2.1rem;
        }
    }

    .post-card__title {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 0.35rem;
        font-size: 1.18rem;
        line-height: 1.45;
        font-weight: 700;
        letter-spacing: -0.005em;
        color: var(--deep-text);
        transition: color 0.2s ease;
    }

    @media (min-width: 768px) {
        .post-card__title {
            font-size: 1.42rem;
            line-height: 1.35;
        }
    }

    :global(.dark) .post-card__title {
        color: oklch(0.95 0.008 var(--hue));
    }

    .post-card__title:hover {
        color: var(--primary);
    }

    .post-card__pin {
        flex-shrink: 0;
        margin-top: 0.28em;
        font-size: 1rem;
        color: var(--primary);
    }

    .post-card__title-arrow {
        flex-shrink: 0;
        margin-top: 0.18em;
        font-size: 1.35rem;
        color: var(--primary);
        opacity: 0;
        transform: translateX(-0.35rem);
        transition: opacity 0.28s var(--ease-soft), transform 0.28s var(--ease-soft);
    }

    .post-card:hover .post-card__title-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    .post-card__meta {
        margin-top: 0.7rem;
    }

    .post-card__desc {
        margin-top: 0.7rem;
        font-size: 0.875rem;
        line-height: 1.65;
        color: var(--content-meta);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-card__footer {
        margin-top: auto;
        padding-top: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.75rem;
        color: var(--content-meta);
    }

    .post-card__stat {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        opacity: 0.85;
    }

    .post-card__stat :global(svg) {
        font-size: 0.95rem;
        opacity: 0.75;
    }

    .post-card__dot {
        width: 3px;
        height: 3px;
        border-radius: 999px;
        background: currentColor;
        opacity: 0.35;
    }

    .post-card__more {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.05rem;
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--primary);
        opacity: 0.9;
        transition: opacity 0.2s ease, gap 0.2s ease;
    }

    .post-card__more:hover {
        opacity: 1;
        gap: 0.25rem;
    }

    .post-card__more :global(svg) {
        font-size: 1.1rem;
    }

    /* 封面 */
    .post-card__media {
        display: block;
        flex: 0 0 auto;
        padding: 0.75rem 0.75rem 0;
    }

    @media (min-width: 768px) {
        .post-card__media {
            flex: 0 0 31%;
            padding: 0.7rem 0.7rem 0.7rem 0;
            min-height: 11rem;
        }
    }

    .post-card__media-inner {
        position: relative;
        display: block;
        height: 100%;
        min-height: 9.5rem;
        overflow: hidden;
        border-radius: calc(var(--radius-large) - 0.45rem);
        background: var(--card-bg-alt);
        box-shadow: inset 0 0 0 1px var(--hairline);
    }

    .post-card__media-scrim {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient(to top, oklch(0 0 0 / 0.34), oklch(0 0 0 / 0) 55%);
        opacity: 1;
        transition: opacity 0.45s var(--ease-soft);
        pointer-events: none;
    }

    .post-card:hover .post-card__media-scrim {
        opacity: 0.35;
    }

    .post-card__media-hint {
        position: absolute;
        z-index: 3;
        right: 0.6rem;
        bottom: 0.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        font-size: 1.1rem;
        color: oklch(0.25 0.03 var(--hue));
        background: oklch(1 0 0 / 0.9);
        box-shadow: 0 6px 18px -6px oklch(0 0 0 / 0.5);
        opacity: 0;
        transform: translateY(0.35rem) scale(0.9);
        transition: opacity 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
    }

    .post-card:hover .post-card__media-hint {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    .post-card__media :global(img) {
        transition: transform 0.9s var(--ease-soft);
    }

    .post-card:hover .post-card__media :global(img) {
        transform: scale(1.06);
    }

    /* 无封面：右侧留一个箭头入口 */
    .post-card__fallback-arrow {
        display: none;
        align-items: center;
        justify-content: center;
        align-self: center;
        width: 3rem;
        height: 3rem;
        margin: 0 0.85rem 0 0;
        border-radius: 50%;
        font-size: 1.5rem;
        color: var(--primary);
        background: var(--btn-regular-bg);
        transition: background-color 0.2s ease, transform 0.2s var(--ease-soft);
    }

    .post-card__fallback-arrow:hover {
        background: var(--btn-regular-bg-hover);
        transform: translateX(2px);
    }

    @media (min-width: 768px) {
        .post-card--nocover .post-card__fallback-arrow {
            display: flex;
        }
    }
</style>
