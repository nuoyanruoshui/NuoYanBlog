---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="category-row">
    <span class="category-row__name"><slot></slot></span>
    {badge !== undefined && badge !== null && badge !== '' && (
        <span class="category-row__badge">{badge}</span>
    )}
</a>

<style>
    .category-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
        height: 2.15rem;
        padding: 0 0.5rem;
        border-radius: 0.6rem;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--content-meta);
        transition: background-color 0.2s ease, color 0.2s ease, padding-left 0.2s ease;
    }

    .category-row:hover {
        padding-left: 0.75rem;
        color: var(--primary);
        background: var(--btn-plain-bg-hover);
    }

    .category-row__name {
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .category-row__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.6rem;
        height: 1.45rem;
        padding: 0 0.4rem;
        border-radius: 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--primary);
        background: var(--primary-subtle);
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .category-row:hover .category-row__badge {
        color: oklch(1 0 0);
        background: var(--primary);
    }
</style>
