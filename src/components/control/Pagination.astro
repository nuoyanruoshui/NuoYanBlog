---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<div class:list={[className, "pager"]} style={style}>
    <a href={page.url.prev || ""} aria-label={page.url.prev ? "Previous Page" : null}
       class:list={["pager__nav", { "pager__nav--disabled": page.url.prev == undefined }]}>
        <Icon name="material-symbols:chevron-left-rounded"></Icon>
    </a>

    <div class="pager__pages">
        {pages.map((p) => {
            if (p == HIDDEN)
                return <span class="pager__ellipsis"><Icon name="material-symbols:more-horiz"></Icon></span>;
            if (p == page.currentPage)
                return <span class="pager__item pager__item--active">{p}</span>;
            return <a href={url(getPageUrl(p))} aria-label={`Page ${p}`} class="pager__item">{p}</a>;
        })}
    </div>

    <a href={page.url.next || ""} aria-label={page.url.next ? "Next Page" : null}
       class:list={["pager__nav", { "pager__nav--disabled": page.url.next == undefined }]}>
        <Icon name="material-symbols:chevron-right-rounded"></Icon>
    </a>
</div>

<style>
    .pager {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .pager__nav {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 0.75rem;
        font-size: 1.35rem;
        color: var(--primary);
        background: var(--card-bg);
        box-shadow: var(--shadow-card);
        transition: background-color 0.2s ease, box-shadow 0.25s ease, transform 0.2s var(--ease-soft), opacity 0.2s ease;
    }

    .pager__nav:hover {
        box-shadow: var(--shadow-card-hover);
        transform: translateY(-1px);
    }

    .pager__nav--disabled {
        opacity: 0.35;
        pointer-events: none;
    }

    .pager__pages {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem;
        border-radius: 0.9rem;
        background: var(--card-bg);
        box-shadow: var(--shadow-card);
    }

    .pager__item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.85rem;
        height: 1.85rem;
        padding: 0 0.4rem;
        border-radius: 0.6rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--content-meta);
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .pager__item:hover {
        color: var(--primary);
        background: var(--primary-subtle);
    }

    .pager__item--active {
        color: oklch(1 0 0);
        background: linear-gradient(135deg, var(--primary), oklch(0.72 0.15 calc(var(--hue) + 40)));
        box-shadow: 0 6px 16px -8px oklch(0.68 0.16 var(--hue) / 0.8);
    }

    :global(.dark) .pager__item--active {
        color: oklch(0.22 0.04 var(--hue));
    }

    .pager__ellipsis {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--content-meta);
        opacity: 0.6;
    }
</style>
