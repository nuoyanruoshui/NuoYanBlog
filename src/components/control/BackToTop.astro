---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <button
        id="back-to-top-btn"
        class="back-to-top-btn hide"
        aria-label="Back to Top"
        onclick="backToTop()"
    >
        <Icon name="material-symbols:keyboard-arrow-up-rounded" />
    </button>
</div>

<style lang="stylus">
.back-to-top-wrapper
    pointer-events: none

.back-to-top-btn
    position: fixed
    right: 1.25rem
    bottom: 5.5rem
    z-index: 50
    display: inline-flex
    align-items: center
    justify-content: center
    width: 2.75rem
    height: 2.75rem
    border-radius: 0.9rem
    font-size: 1.5rem
    color: var(--primary)
    background: var(--card-bg)
    box-shadow: var(--shadow-card)
    pointer-events: auto
    cursor: pointer
    transition: opacity 0.3s var(--ease-soft), transform 0.3s var(--ease-soft), box-shadow 0.3s var(--ease-soft)

    &:hover
        box-shadow: var(--shadow-card-hover)
        transform: translateY(-2px)

    &:active
        transform: translateY(0) scale(0.94)

    &.hide
        opacity: 0
        transform: translateY(0.5rem) scale(0.92)
        pointer-events: none
</style>

<script is:raw is:inline>
function backToTop() {
    // 直接使用原生滚动，避免OverlayScrollbars冲突
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
