---
/**
 * 可交互星空背景：
 * - 固定铺满视口，独立 canvas，不拦截点击
 * - 星星按深度分层，鼠标移动时产生视差
 * - 光标附近星星会变亮，并用极淡的连线成「星座」
 * - 尊重 prefers-reduced-motion / 页面隐藏时暂停
 */
---

<canvas id="star-field" aria-hidden="true"></canvas>

<style>
    #star-field {
        position: fixed;
        inset: 0;
        z-index: -1;
        width: 100%;
        height: 100%;
        pointer-events: none;
        /* 与 html::before 的极光叠加：极光在下，星空在上 */
        opacity: 1;
    }
</style>

<script>
    (() => {
        const canvas = document.getElementById("star-field");
        if (!(canvas instanceof HTMLCanvasElement)) return;

        const ctx = canvas.getContext("2d", { alpha: true });
        if (!ctx) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let W = 0;
        let H = 0;
        let DPR = 1;

        /** 星星：x/y 归一化坐标，depth 越大越"近"（视差与尺寸都更大） */
        type Star = {
            x: number;
            y: number;
            depth: number;
            r: number;
            alpha: number;
            phase: number;
            speed: number;
            driftX: number;
            driftY: number;
            tint: number; // 0 白 / 1 粉 / 2 淡紫
        };

        let stars: Star[] = [];

        const mouse = { x: 0, y: 0 }; // -1..1 归一化（相对屏幕中心）
        const smooth = { x: 0, y: 0 }; // 视差平滑后的值
        const pointer = { x: -9999, y: -9999, active: false };

        function currentPalette() {
            const dark = document.documentElement.classList.contains("dark");
            return dark
                ? {
                        core: ["#ffffff", "#ffd7ea", "#e3d4ff"],
                        glow: "255, 214, 234",
                        baseAlpha: 0.95,
                        line: "rgba(255, 200, 226,",
                    }
                : {
                        core: ["#8f74c9", "#d97fae", "#7d6bb8"],
                        glow: "170, 110, 200",
                        baseAlpha: 0.78,
                        line: "rgba(150, 100, 190,",
                    };
        }

        let palette = currentPalette();

        function resize() {
            DPR = Math.min(window.devicePixelRatio || 1, 2);
            W = window.innerWidth;
            H = window.innerHeight;
            canvas.width = Math.floor(W * DPR);
            canvas.height = Math.floor(H * DPR);
            canvas.style.width = `${W}px`;
            canvas.style.height = `${H}px`;
            ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
            buildStars();
        }

        function buildStars() {
            // 按面积给数量，手机上不要太多
            const count = Math.round(Math.min(260, Math.max(90, (W * H) / 9000)));
            stars = Array.from({ length: count }, () => {
                const depth = 0.25 + Math.random() * 0.75;
                return {
                    x: Math.random(),
                    y: Math.random(),
                    depth,
                    r: 0.4 + depth * 1.9 * Math.random() + 0.2,
                    alpha: 0.25 + Math.random() * 0.75,
                    phase: Math.random() * Math.PI * 2,
                    speed: 0.4 + Math.random() * 1.1,
                    driftX: (Math.random() - 0.5) * 0.02,
                    driftY: 0.006 + Math.random() * 0.014,
                    tint: Math.random() < 0.6 ? 0 : Math.random() < 0.6 ? 1 : 2,
                };
            });
        }

        // 鼠标：归一化 + 记录指针位置（用于星座连线）
        window.addEventListener(
            "pointermove",
            (e) => {
                const rect = canvas.getBoundingClientRect();
                pointer.x = e.clientX - rect.left;
                pointer.y = e.clientY - rect.top;
                pointer.active = true;
                mouse.x = (e.clientX / window.innerWidth - 0.5) * 2;
                mouse.y = (e.clientY / window.innerHeight - 0.5) * 2;
            },
            { passive: true },
        );

        window.addEventListener(
            "pointerleave",
            () => {
                pointer.active = false;
                mouse.x = 0;
                mouse.y = 0;
            },
            { passive: true },
        );

        window.addEventListener("blur", () => {
            mouse.x = 0;
            mouse.y = 0;
            pointer.active = false;
        });

        // 流星
        type Meteor = { x: number; y: number; vx: number; vy: number; life: number; max: number };
        let meteor: Meteor | null = null;
        let meteorTimer = 4 + Math.random() * 5;

        let raf = 0;
        let last = performance.now();
        let time = 0;

        function frame(now: number) {
            const dt = Math.min(48, now - last) / 1000;
            last = now;
            time += dt;

            // 视差平滑
            smooth.x += (mouse.x - smooth.x) * Math.min(1, dt * 6);
            smooth.y += (mouse.y - smooth.y) * Math.min(1, dt * 6);

            // 同步给 CSS：底层极光层也跟着轻微位移，整张背景都会"粘"着鼠标
            document.documentElement.style.setProperty("--mx", smooth.x.toFixed(3));
            document.documentElement.style.setProperty("--my", smooth.y.toFixed(3));

            ctx.clearRect(0, 0, W, H);

            // 流星：偶尔划一道，让背景"活着"
            if (!reduceMotion) {
                meteorTimer -= dt;
                if (!meteor && meteorTimer <= 0) {
                    const fromLeft = Math.random() < 0.5;
                    meteor = {
                        x: fromLeft ? -80 : W + 80,
                        y: -40 - Math.random() * H * 0.25,
                        vx: (fromLeft ? 1 : -1) * (520 + Math.random() * 260),
                        vy: 220 + Math.random() * 140,
                        life: 0,
                        max: 1.6,
                    };
                    meteorTimer = 9 + Math.random() * 10;
                }
                if (meteor) {
                    meteor.life += dt;
                    meteor.x += meteor.vx * dt;
                    meteor.y += meteor.vy * dt;
                    const fade = Math.sin((meteor.life / meteor.max) * Math.PI);
                    if (meteor.life > meteor.max || meteor.y > H + 120) {
                        meteor = null;
                    } else {
                        const tailX = meteor.x - meteor.vx * 0.26;
                        const tailY = meteor.y - meteor.vy * 0.26;
                        const g = ctx.createLinearGradient(meteor.x, meteor.y, tailX, tailY);
                        g.addColorStop(0, `rgba(${palette.glow}, ${(0.85 * fade).toFixed(3)})`);
                        g.addColorStop(1, `rgba(${palette.glow}, 0)`);
                        ctx.strokeStyle = g;
                        ctx.lineWidth = 1.6;
                        ctx.beginPath();
                        ctx.moveTo(meteor.x, meteor.y);
                        ctx.lineTo(tailX, tailY);
                        ctx.stroke();
                        ctx.globalAlpha = fade;
                        ctx.fillStyle = palette.core[0];
                        ctx.beginPath();
                        ctx.arc(meteor.x, meteor.y, 1.8, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.globalAlpha = 1;
                    }
                }
            }

            const parallax = reduceMotion ? 0 : 40;
            const pointerRadius = Math.min(280, Math.max(170, W * 0.14));

            // 先收集指针附近的星星，画星座线
            if (pointer.active && !reduceMotion) {
                const near: { x: number; y: number; d: number }[] = [];
                for (const s of stars) {
                    const px = s.x * W - smooth.x * s.depth * parallax;
                    const py = s.y * H - smooth.y * s.depth * parallax;
                    const d = Math.hypot(px - pointer.x, py - pointer.y);
                    if (d < pointerRadius) near.push({ x: px, y: py, d });
                }
                near.sort((a, b) => a.d - b.d);
                const lines = near.slice(0, 18);
                ctx.lineWidth = 1;
                for (const p of lines) {
                    const t = 1 - p.d / pointerRadius;
                    ctx.strokeStyle = `${palette.line}${(0.08 + t * 0.26).toFixed(3)})`;
                    ctx.beginPath();
                    ctx.moveTo(pointer.x, pointer.y);
                    ctx.lineTo(p.x, p.y);
                    ctx.stroke();
                }
            }

            // 画星星
            for (const s of stars) {
                if (!reduceMotion) {
                    s.x += s.driftX * dt * 0.35;
                    s.y += s.driftY * dt * 0.35;
                    if (s.y > 1.02) s.y = -0.02;
                    if (s.x > 1.02) s.x = -0.02;
                    if (s.x < -0.02) s.x = 1.02;
                }

                const px = s.x * W - smooth.x * s.depth * parallax;
                const py = s.y * H - smooth.y * s.depth * parallax;

                const twinkle = reduceMotion ? 0.85 : 0.55 + 0.45 * Math.sin(time * s.speed + s.phase);
                let alpha = s.alpha * twinkle * palette.baseAlpha;

                // 靠近光标变亮
                let boost = 0;
                if (pointer.active && !reduceMotion) {
                    const d = Math.hypot(px - pointer.x, py - pointer.y);
                    if (d < pointerRadius) {
                        boost = 1 - d / pointerRadius;
                        alpha = Math.min(1, alpha + boost * 0.55);
                    }
                }

                const radius = s.r * (0.85 + twinkle * 0.3 + boost * 0.8);

                ctx.globalAlpha = Math.max(0, Math.min(1, alpha));
                ctx.fillStyle = palette.core[s.tint];
                ctx.beginPath();
                ctx.arc(px, py, radius, 0, Math.PI * 2);
                ctx.fill();

                // 大星星带一点光晕
                if (s.depth > 0.85 && (boost > 0.2 || twinkle > 0.9)) {
                    ctx.globalAlpha = Math.min(0.35, alpha * 0.35);
                    const g = ctx.createRadialGradient(px, py, 0, px, py, radius * 6);
                    g.addColorStop(0, `rgba(${palette.glow}, 0.75)`);
                    g.addColorStop(1, `rgba(${palette.glow}, 0)`);
                    ctx.fillStyle = g;
                    ctx.beginPath();
                    ctx.arc(px, py, radius * 6, 0, Math.PI * 2);
                    ctx.fill();
                }
            }

            ctx.globalAlpha = 1;
            raf = requestAnimationFrame(frame);
        }

        function start() {
            if (raf) return;
            last = performance.now();
            raf = requestAnimationFrame(frame);
        }

        function stop() {
            if (!raf) return;
            cancelAnimationFrame(raf);
            raf = 0;
        }

        // 主题切换时换配色
        new MutationObserver(() => {
            palette = currentPalette();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) stop();
            else start();
        });

        let resizeTimer = 0;
        window.addEventListener("resize", () => {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resize, 150);
        });

        resize();
        start();

        // swup 换页后 canvas 一直在，无需重建
    })();
</script>
